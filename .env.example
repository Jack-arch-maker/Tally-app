# Copy to .env (or set these in your host's dashboard). Everything except PORT is optional:
# the app runs without them, and each feature simply switches off until its keys are added.

PORT=5000
NODE_ENV=production

# Where the SQLite database lives. On a host, point this at a persistent disk/volume!
DATA_DIR=./data

# Your account(s) get Pro for free plus the Admin page. Comma-separate for several.
# Sign up in the app with this exact email.
ADMIN_EMAIL=you@example.com

# Public address of your site (used to keep payment redirects on your own domain).
PUBLIC_URL=https://tally.example.com

# Optional: secret used to encrypt bank tokens. Auto-generated and saved in DATA_DIR if omitted.
APP_SECRET=

# --- Penny (needs an Anthropic API key: console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Pro subscriptions (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: your own Price IDs. If blank, Tally creates $11.99/mo and $79.99/yr prices itself.
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=

# --- Bank import (Plaid) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
